ansi(String code): String {
    return "\u001b[" + code + "m"
}

red(Int c): Int {
    return (c >> 16) & 0xFF
}

green(Int c): Int {
    return (c >> 8) & 0xFF
}

blue(Int c): Int {
    return c & 0xFF
}

colorStr(Int c): String {
    return red(c) + ";" + green(c) + ";" + blue(c)
}

class Theme {
    String name = "Dracula"
    Int bg = 0xFF282A36
    Int fg = 0xFFF8F8F2
    Int header = 0xFF21222C
    Int selection = 0xFF44475A
    Int currentLine = 0xFF44475A
    Int gutter = 0xFF6272A4
    Int terminal = 0xFF21222C
    Int terminalFg = 0xFF50FA7B
    Int keyword = 0xFFFF79C6
    Int type = 0xFF8BE9FD
    Int stringColor = 0xFFF1FA8C
    Int charColor = 0xFFF1FA8C
    Int number = 0xFFFFB86C
    Int comment = 0xFF6272A4
    Int operator = 0xFFF8F8F2
    Int punctuation = 0xFFF8F8F2
    Int identifier = 0xFFF8F8F2
    Int error = 0xFFFF5555
}

darkTheme(): Theme {
    return new Theme()
}

lightThemeFrom(Theme t): Theme {
    t.name = "Claro"
    t.bg = 0xFFFFFFFF
    t.fg = 0xFF24292E
    t.header = 0xFFF6F8FA
    t.selection = 0xFFADD6FF
    t.currentLine = 0xFFF6F8FA
    t.gutter = 0xFFA0A8B0
    t.terminal = 0xFF24292E
    t.terminalFg = 0xFF7EE787
    t.keyword = 0xFFCF222E
    t.type = 0xFF0550AE
    t.stringColor = 0xFF0A3069
    t.charColor = 0xFF0A3069
    t.number = 0xFF0550AE
    t.comment = 0xFF6E7781
    t.operator = 0xFF24292E
    t.punctuation = 0xFF24292E
    t.identifier = 0xFF24292E
    t.error = 0xFFCF222E
    return t
}

lightTheme(): Theme {
    return lightThemeFrom(darkTheme())
}


themeToJson(Theme t): String {
    return "{\"name\":\"" + t.name + "\",\"bg\":\"" + colorStr(t.bg) + "\",\"fg\":\"" + colorStr(t.fg) +
        "\",\"header\":\"" + colorStr(t.header) + "\",\"selection\":\"" + colorStr(t.selection) +
        "\",\"currentLine\":\"" + colorStr(t.currentLine) + "\",\"gutter\":\"" + colorStr(t.gutter) +
        "\",\"terminal\":\"" + colorStr(t.terminal) + "\",\"terminalFg\":\"" + colorStr(t.terminalFg) +
        "\",\"keyword\":\"" + colorStr(t.keyword) + "\",\"type\":\"" + colorStr(t.type) +
        "\",\"string\":\"" + colorStr(t.stringColor) + "\",\"char\":\"" + colorStr(t.charColor) +
        "\",\"number\":\"" + colorStr(t.number) + "\",\"comment\":\"" + colorStr(t.comment) +
        "\",\"operator\":\"" + colorStr(t.operator) + "\",\"punctuation\":\"" + colorStr(t.punctuation) +
        "\",\"identifier\":\"" + colorStr(t.identifier) + "\",\"error\":\"" + colorStr(t.error) + "\"}"
}

themeAt(Int index): String {
    if (index == 1) {
        return themeToJson(lightTheme())
    }
    return themeToJson(darkTheme())
}

themeNames(): String {
    return json.encode(listOf("Escuro", "Claro"))
}

hex2(Int c): String {
    var r = (c >> 16) & 0xFF
    var g = (c >> 8) & 0xFF
    var b = c & 0xFF
    return "#" + hexByte(r) + hexByte(g) + hexByte(b)
}

hexByte(Int v): String {
    var digits = "0123456789ABCDEF"
    var hi = (v >> 4) & 0xF
    var lo = v & 0xF
    return digits.substring(hi, hi + 1) + digits.substring(lo, lo + 1)
}

themeToYaml(Theme t): String {
    var out = "# tema do Kof Editor (chave: \"#RRGGBB\")\n"
    out = out + "name: \"" + t.name + "\"\n"
    out = out + "bg: \"" + hex2(t.bg) + "\"\n"
    out = out + "fg: \"" + hex2(t.fg) + "\"\n"
    out = out + "header: \"" + hex2(t.header) + "\"\n"
    out = out + "selection: \"" + hex2(t.selection) + "\"\n"
    out = out + "currentLine: \"" + hex2(t.currentLine) + "\"\n"
    out = out + "gutter: \"" + hex2(t.gutter) + "\"\n"
    out = out + "terminal: \"" + hex2(t.terminal) + "\"\n"
    out = out + "terminalFg: \"" + hex2(t.terminalFg) + "\"\n"
    out = out + "keyword: \"" + hex2(t.keyword) + "\"\n"
    out = out + "type: \"" + hex2(t.type) + "\"\n"
    out = out + "string: \"" + hex2(t.stringColor) + "\"\n"
    out = out + "char: \"" + hex2(t.charColor) + "\"\n"
    out = out + "number: \"" + hex2(t.number) + "\"\n"
    out = out + "comment: \"" + hex2(t.comment) + "\"\n"
    out = out + "operator: \"" + hex2(t.operator) + "\"\n"
    out = out + "punctuation: \"" + hex2(t.punctuation) + "\"\n"
    out = out + "identifier: \"" + hex2(t.identifier) + "\"\n"
    out = out + "error: \"" + hex2(t.error) + "\"\n"
    return out
}

yamlValue(String line): String {
    var colon = line.indexOf(":")
    if (colon < 0) {
        return ""
    }
    var v = line.substring(colon + 1, line.length()).trim()
    var len = v.length()
    if (len >= 2 && v.substring(0, 1) == "\"" && v.substring(len - 1, len) == "\"") {
        return v.substring(1, len - 1)
    }
    return v
}

colorFromHex(String s): Int {
    var hex = s
    if (s.substring(0, 1) == "#") {
        hex = s.substring(1, s.length())
    }
    if (hex.length() < 6) {
        return 0xFF282A36
    }
    var digits = "0123456789abcdefABCDEF"
    var out = 0xFF000000
    var i = 0
    while (i < 6) {
        var c = hex.substring(i, i + 1)
        var d = 0
        var k = 0
        while (k < 16) {
            var dk = digits.substring(k, k + 1)
            if (dk == c || dk == c.toLowerCase()) {
                d = k
            }
            k = k + 1
        }
        out = (out << 4) | d
        i = i + 1
    }
    return out
}

themeFromYaml(String yaml): Theme {
    var t = darkTheme()
    var lines = yaml.split("\n")
    for (var line in lines) {
        var l = line.trim()
        var colon = l.indexOf(":")
        if (colon <= 0) {
            continue
        }
        var key = l.substring(0, colon).trim()
        var v = yamlValue(l)
        if (v.length() == 0) {
            continue
        }
        if (l.startsWith("name:")) {
            t.name = v
        } else if (l.startsWith("bg:")) {
            t.bg = colorFromHex(v)
        } else if (l.startsWith("fg:")) {
            t.fg = colorFromHex(v)
        } else if (l.startsWith("header:")) {
            t.header = colorFromHex(v)
        } else if (l.startsWith("selection:")) {
            t.selection = colorFromHex(v)
        } else if (l.startsWith("currentLine:")) {
            t.currentLine = colorFromHex(v)
        } else if (l.startsWith("gutter:")) {
            t.gutter = colorFromHex(v)
        } else if (l.startsWith("terminal:")) {
            t.terminal = colorFromHex(v)
        } else if (l.startsWith("terminalFg:")) {
            t.terminalFg = colorFromHex(v)
        } else if (l.startsWith("keyword:")) {
            t.keyword = colorFromHex(v)
        } else if (l.startsWith("type:")) {
            t.type = colorFromHex(v)
        } else if (l.startsWith("string:")) {
            t.stringColor = colorFromHex(v)
        } else if (l.startsWith("char:")) {
            t.charColor = colorFromHex(v)
        } else if (l.startsWith("number:")) {
            t.number = colorFromHex(v)
        } else if (l.startsWith("comment:")) {
            t.comment = colorFromHex(v)
        } else if (l.startsWith("operator:")) {
            t.operator = colorFromHex(v)
        } else if (l.startsWith("punctuation:")) {
            t.punctuation = colorFromHex(v)
        } else if (l.startsWith("identifier:")) {
            t.identifier = colorFromHex(v)
        } else if (l.startsWith("error:")) {
            t.error = colorFromHex(v)
        }
    }
    return t
}
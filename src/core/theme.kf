    out = out + ",\"tk.constant\":\"" + colorStr(t.constant) + "\""
    out = out + ",\"tk.enumMember\":\"" + colorStr(t.enumMember) + "\""
    out = out + ",\"tk.annotation\":\"" + colorStr(t.annotation) + "\""
    out = out + ",\"tk.operator\":\"" + colorStr(t.operator) + "\""

hex2(Int c): String {
    var r = (c >> 16) & 0xFF
    var g = (c >> 8) & 0xFF
    var b = c & 0xFF
    return "#" + hexByte(r) + hexByte(g) + hexByte(b)
}

hexByte(Int v): String {
    var digits = "0123456789ABCDEF"
    var hi = (v >> 4) & 0xF
    var lo = v & 0xF
    return digits.substring(hi, hi + 1) + digits.substring(lo, lo + 1)
}

themeToYaml(Theme t): String {
    var out = "# tema do Kof Editor (chave: \"#RRGGBB\")\n"
    out = out + "name: \"" + t.name + "\"\n"
    // bloco 1: interface
    out = out + "interface:\n"
    out = out + "  headerBg: \"" + hex2(t.header) + "\"\n"
    out = out + "  headerFg: \"" + hex2(t.headerFg) + "\"\n"
    out = out + "  headerBorder: \"" + hex2(t.headerBorder) + "\"\n"
    out = out + "  activityBg: \"" + hex2(t.activityBg) + "\"\n"
    out = out + "  activityFg: \"" + hex2(t.activityFg) + "\"\n"
    out = out + "  activityActive: \"" + hex2(t.activityActive) + "\"\n"
    out = out + "  activityBadge: \"" + hex2(t.activityBadge) + "\"\n"
    out = out + "  sidebarBg: \"" + hex2(t.sidebarBg) + "\"\n"
    out = out + "  sidebarFg: \"" + hex2(t.sidebarFg) + "\"\n"
    out = out + "  sidebarHover: \"" + hex2(t.sidebarHover) + "\"\n"
    out = out + "  sidebarSelected: \"" + hex2(t.sidebarSelected) + "\"\n"
    out = out + "  fileModified: \"" + hex2(t.fileModified) + "\"\n"
    out = out + "  fileAdded: \"" + hex2(t.fileAdded) + "\"\n"
    out = out + "  fileDeleted: \"" + hex2(t.fileDeleted) + "\"\n"
    out = out + "  fileUntracked: \"" + hex2(t.fileUntracked) + "\"\n"
    out = out + "  fileConflict: \"" + hex2(t.fileConflict) + "\"\n"
    out = out + "  fileIgnored: \"" + hex2(t.fileIgnored) + "\"\n"
    out = out + "  inputBg: \"" + hex2(t.inputBg) + "\"\n"
    out = out + "  inputFg: \"" + hex2(t.inputFg) + "\"\n"
    out = out + "  inputBorder: \"" + hex2(t.inputBorder) + "\"\n"
    out = out + "  inputBorderFocus: \"" + hex2(t.inputBorderFocus) + "\"\n"
    out = out + "  inputPlaceholder: \"" + hex2(t.inputPlaceholder) + "\"\n"
    out = out + "  tabBg: \"" + hex2(t.tabBg) + "\"\n"
    out = out + "  tabFg: \"" + hex2(t.tabFg) + "\"\n"
    out = out + "  tabActiveBg: \"" + hex2(t.tabActiveBg) + "\"\n"

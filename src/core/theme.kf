    out = out + "  fg: \"" + hex2(t.fg) + "\"\n"
    out = out + "  cursor: \"" + hex2(t.cursor) + "\"\n"
    out = out + "  selectionBg: \"" + hex2(t.selection) + "\"\n"
    out = out + "  currentLineBg: \"" + hex2(t.currentLine) + "\"\n"

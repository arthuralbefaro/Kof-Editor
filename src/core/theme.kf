ansi(String code): String {
    return "\u001b[" + code + "m"
}

red(Int c): Int {
    return (c >> 16) & 0xFF
}

green(Int c): Int {
    return (c >> 8) & 0xFF
}

blue(Int c): Int {
    return c & 0xFF
}

colorStr(Int c): String {
    return red(c) + ";" + green(c) + ";" + blue(c)
}


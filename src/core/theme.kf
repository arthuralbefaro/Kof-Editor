    // bloco 3: tokens
    out = out + "tokens:\n"
    out = out + "  keyword: \"" + hex2(t.keyword) + "\"\n"
    out = out + "  keywordControl: \"" + hex2(t.keywordControl) + "\"\n"
    out = out + "  keywordModifier: \"" + hex2(t.keywordModifier) + "\"\n"
    out = out + "  type: \"" + hex2(t.type) + "\"\n"
    out = out + "  string: \"" + hex2(t.stringColor) + "\"\n"
    out = out + "  stringEscape: \"" + hex2(t.stringEscape) + "\"\n"
    out = out + "  char: \"" + hex2(t.charColor) + "\"\n"
    out = out + "  number: \"" + hex2(t.number) + "\"\n"
    out = out + "  boolean: \"" + hex2(t.boolean) + "\"\n"
    out = out + "  nullLiteral: \"" + hex2(t.nullLiteral) + "\"\n"
    out = out + "  comment: \"" + hex2(t.comment) + "\"\n"
    out = out + "  todo: \"" + hex2(t.todo) + "\"\n"
    out = out + "  functionCall: \"" + hex2(t.functionCall) + "\"\n"
    out = out + "  functionDecl: \"" + hex2(t.functionDecl) + "\"\n"
    out = out + "  identifier: \"" + hex2(t.identifier) + "\"\n"
    out = out + "  parameter: \"" + hex2(t.parameter) + "\"\n"
    out = out + "  constant: \"" + hex2(t.constant) + "\"\n"
    out = out + "  enumMember: \"" + hex2(t.enumMember) + "\"\n"
    out = out + "  annotation: \"" + hex2(t.annotation) + "\"\n"
    out = out + "  operator: \"" + hex2(t.operator) + "\"\n"
    out = out + "  punctuation: \"" + hex2(t.punctuation) + "\"\n"
    out = out + "  error: \"" + hex2(t.error) + "\"\n"
    out = out + "  errorUnderline: \"" + hex2(t.errorUnderline) + "\"\n"
    out = out + "  warningUnderline: \"" + hex2(t.warningUnderline) + "\"\n"
    return out
}

yamlValue(String line): String {
    var colon = line.indexOf(":")
    if (colon < 0) {
        return ""
    }
    var v = line.substring(colon + 1, line.length()).trim()
    var len = v.length()
    if (len >= 2 && v.substring(0, 1) == "\"" && v.substring(len - 1, len) == "\"") {
        return v.substring(1, len - 1)
    }
    return v
}

colorFromHex(String s): Int {
    var hex = s
    if (s.substring(0, 1) == "#") {
        hex = s.substring(1, s.length())
    }
    if (hex.length() < 6) {
        return 0xFF282A36
    }
    var digits = "0123456789abcdefABCDEF"
    var out = 0xFF000000
    var i = 0
    while (i < 6) {
        var c = hex.substring(i, i + 1)
        var d = 0
        var k = 0
        while (k < 16) {
            var dk = digits.substring(k, k + 1)
            if (dk == c || dk == c.toLowerCase()) {
                d = k
            }
            k = k + 1
        }
        out = (out << 4) | d
        i = i + 1
    }
    return out
}

themeFromYaml(String yaml): Theme {
    var t = darkTheme()
    var lines = yaml.split("\n")
    var block = ""
    for (var line in lines) {
        var l = line.trim()
        var colon = l.indexOf(":")
        if (colon <= 0) {
            continue
        }
        var first = " "
        if (line.length() > 0) {
            first = line.substring(0, 1)
        }
        var indented = first == " " || first == "\t"
        var key = l.substring(0, colon).trim()
        var v = yamlValue(l)
        if (indented) {
            if (block == "interface") {
                themeApplyField(t, "if." + key, v)
            } else if (block == "editor") {
                themeApplyField(t, "ed." + key, v)
            } else if (block == "tokens") {
                themeApplyField(t, "tk." + key, v)
            }
            continue
        }
        if (l == "interface:" || l == "editor:" || l == "tokens:") {
            block = key
            continue
        }
        block = ""
        if (v.length() == 0) {
            continue
        }
        themeApplyField(t, key, v)
    }
    return t
}

// dispatcher: 1 ponto de mapeamento chave→campo (flat e blocos)
themeApplyField(Theme t, String key, String v): void {
    if (key == "name") {
        if (v.length() > 0) {
            t.name = v
        }
        return
    }
    if (v.length() < 7) {
        return
    }
    if (key == "bg" || key == "ed.bg") {
        t.bg = colorFromHex(v)
    } else if (key == "fg" || key == "ed.fg") {
        t.fg = colorFromHex(v)
    } else if (key == "header" || key == "if.headerBg") {
        t.header = colorFromHex(v)
    } else if (key == "selection" || key == "ed.selectionBg") {
        t.selection = colorFromHex(v)
    } else if (key == "currentLine" || key == "ed.currentLineBg") {

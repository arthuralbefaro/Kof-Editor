    out = out + ",\"tk.errorUnderline\":\"" + colorStr(t.errorUnderline) + "\""
    out = out + ",\"tk.warningUnderline\":\"" + colorStr(t.warningUnderline) + "\""
    out = out + "}"
    return out
}

themeAt(Int index): String {
    return themeToJson(themeAtTheme(index))
}

themeAtTheme(Int index): Theme {
    if (index == 1) {
        return lightTheme()
    }
    if (index == 2) {
        return paletteNord()
    }
    if (index == 3) {
        return paletteGitHubDark()
    }
    if (index == 4) {
        return paletteSolarizedDark()
    }
    if (index == 5) {
        return paletteMonokai()
    }
    return darkTheme()
}

themeNames(): String {
    return json.encode(listOf("Dracula", "Claro", "Nord", "GitHub Dark", "Solarized Dark", "Monokai"))
}

